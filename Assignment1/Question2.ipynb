    "result = 0\n",
    "if(x<0):\n",
    "    pass\n",
    "elif(0<=x<=5):\n",
    "    result = (x**2)\n",
    "elif(5<x<=10):\n",
    "    result = (5*x) - 9\n",
    "else:\n",
    "    result = 44\n",
    "print(f\"The output is {result}. \")"
