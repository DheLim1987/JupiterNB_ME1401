    "import math\n",
    "area = 0\n",
    "u = 0.00001\n",
    "b = 0\n",
    "while(b>=0):\n",
    "    b = b + u\n",
    "    area = area + (1/2)*(u)*(b - (math.e**(-b)) + (b + u) - (math.e**(-(b+u))))\n",
    "    if (area>0):\n",
    "        print(b)\n",
    "        break\n",
    "\n",
