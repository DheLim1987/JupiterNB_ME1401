    "import array as arr\n",
    "sum = 0\n",
    "marks = arr.array('i',[12,4,5,3,8,7,10,15,9,11])\n",
    "for i in range(0,10,1):\n",
    "    sum = sum + marks[i]\n",
    "mean = sum/10\n",
    "print(mean)\n",
    "\n",
    "res = arr.array('i', sorted(marks))\n",
    "median = (res[4] + res[5])/2\n",
    "print(median)\n",
    "\n"
   ]
