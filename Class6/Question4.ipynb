   ],
   "source": [
    "num = int(input(\"The factorial of number is: \"))\n",
    "fac = 1\n",
    "if(num==0):\n",
    "    print(\"Factorial is 1\")\n",
    "elif(num<0):\n",
    "    print(\"Factorial not defined\")\n",
    "else:\n",
    "    for k in range(1,num+1,1):\n",
    "        fac = fac*k\n",
    "    print(f\"Factorial is {fac}\")"
   ]
  },
